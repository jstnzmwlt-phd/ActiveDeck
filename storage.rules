rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSuperAdmin() {
      return request.auth != null && 
             'email' in request.auth.token && 
             (request.auth.token.email.lower() == 'justin.zumwalt@okstate.edu' ||
              request.auth.token.email.lower() == 'jstnzmwlt@gmail.com');
    }

    // Global, public app logo.
    // Anyone can read this file, but only SuperAdmins can write it.
    match /public/app_logo.png {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Match the path for institution logos
    match /logos/{institutionId}/logo.png {
      // Allow any user to read (view) the logos.
      allow read: if request.auth != null || true;

      // Allow writes (create, update, delete) only for Super Admins.
      allow write: if isSuperAdmin();
    }

    // Match presentation decks (pptx & odp files loaded by the presenter)
    match /presentations/{presentationId}/decks/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && 
                   request.resource.size < 150 * 1024 * 1024;
    }

    // Match the path for presentation documents & pushed slides
    match /presentations/{presentationId}/{folder}/{fileName} {
      allow read: if request.auth != null || folder == 'decks' || fileName.matches('.*\\.(pptx|odp)');
      allow write: if request.auth != null && (
        folder == 'documents' || 
        folder == 'decks' || 
        folder == 'pushed_slides' || 
        folder == 'slide_previews' || 
        folder == 'pushed_notes' || 
        folder == 'source' ||
        fileName.matches('.*\\.(pptx|odp)')
      ) && request.resource.size < 100 * 1024 * 1024;
    }

    // Match root presentation files directly in presentation directory (e.g., source.pptx, source.odp)
    match /presentations/{presentationId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && 
                   (fileName == 'source.pptx' || fileName == 'source.odp' || fileName.matches('.*\\.(pptx|odp)')) &&
                   request.resource.size < 150 * 1024 * 1024;
    }
  }
}
