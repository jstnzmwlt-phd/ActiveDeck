rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model & Documentation
    // ===============================================================
    //
    // Collection: /presentations/{presentationId}
    //   - presenterId: string (UID of creator/presenter)
    //   - presenterEmail: string (optional email of presenter)
    //   - pinCode: string (6-digit session PIN)
    //   - isLocked: bool (optional, protects session from deletion)
    //   - disableAttendance: bool (optional)
    //   - hideComments: bool (optional)
    //   - currentSlide: int (current slide index)
    //   - createdAt: timestamp
    //
    // Subcollection: /presentations/{presentationId}/attendance_tokens/{tokenId}
    //   - token: string (rotating verification token)
    //   - createdAt: number (epoch ms)
    //
    // Subcollection: /presentations/{presentationId}/attendance/{studentEmail}
    //   - name: string (student display name)
    //   - email: string (student email)
    //   - checkedInAt: timestamp
    //   - scannedToken: string (optional)
    //   - authMethod: string (QR or URL or Screen Icon Match)
    //
    // Collection: /messages/{messageId}
    //   - presentationId: string
    //   - userId: string (sender UID)
    //   - text: string
    //   - timestamp: timestamp
    //
    // Collections: /polls/{pollId}, /wordClouds/{cloudId}, /openEndedQuestions/{questionId}
    //   - presentationId: string
    //   - active: bool
    //   - votes / words / responses: map of userId -> answer
    //
    // Collection: /settings/{docId}
    //   - docId: 'global'
    //   - theme: map (primaryColor, secondaryColor, logoUrl)
    //   - activeInstitutionDomain: string
    //
    // Collection: /savedThemes/{docId}
    //   - name: string
    //   - theme: map
    //   - domain: string
    //
    // Collection: /whitelistedPresenters/{email}
    //   - email: document ID (lowercase)
    //   - addedAt: timestamp
    //   - savedDecks: list of deck objects
    //
    // Collections: /sessionPins/{pin}, /participants/{participantId}, /slidePreviews/{previewId}, /test/{docId}
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the request is authenticated (including anonymous sign-ins)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user is the SuperAdmin (Justin Zumwalt)
    function isSuperAdmin() {
      return isAuthenticated() && 
             'email' in request.auth.token && 
             request.auth.token.email.lower() == 'justin.zumwalt@okstate.edu';
    }

    // Check if the current user is a whitelisted presenter
    function isWhitelistedPresenter() {
      return isAuthenticated() && 
             'email' in request.auth.token && 
             (request.auth.token.email.lower() == 'justin.zumwalt@okstate.edu' ||
              exists(/databases/$(database)/documents/whitelistedPresenters/$(request.auth.token.email.lower())));
    }

    // Check if the current user is the owner/presenter of a presentation
    function isPresenter(presId) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/presentations/$(presId)) &&
             get(/databases/$(database)/documents/presentations/$(presId)).data.presenterId == request.auth.uid;
    }

    // ===============================================================
    // Presentations & Attendance
    // ===============================================================

    match /presentations/{presentationId} {
      // Anyone can read presentation configuration; only owners/whitelisted presenters can update.
      // Presentation deletion is restricted to owner or whitelisted presenter and locked presentations cannot be deleted.
      allow read: if true;
      allow create: if isAuthenticated() && (
        !('presenterId' in request.resource.data) || request.resource.data.presenterId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.presenterId == request.auth.uid || 
        isWhitelistedPresenter()
      );
      allow delete: if isAuthenticated() && (
        resource.data.presenterId == request.auth.uid || 
        isWhitelistedPresenter()
      ) && (
        !('isLocked' in resource.data) || resource.data.isLocked != true
      );

      match /attendance_tokens/{tokenId} {
        // Students must be able to read active QR tokens; only the presenter or whitelisted presenter can write/delete them
        allow read: if isAuthenticated();
        allow create, update, delete: if isPresenter(presentationId) || isWhitelistedPresenter();
      }

      match /attendance/{studentEmail} {
        // Students can write (create or update) their own check-in record.
        // If there is an active institution domain globally configured, enforce that student's email matches the domain.
        allow create, update: if isAuthenticated() && (
          !exists(/databases/$(database)/documents/settings/global) ||
          !("activeInstitutionDomain" in get(/databases/$(database)/documents/settings/global).data) ||
          get(/databases/$(database)/documents/settings/global).data.activeInstitutionDomain == "" ||
          get(/databases/$(database)/documents/settings/global).data.activeInstitutionDomain == null ||
          studentEmail.matches(".*@" + get(/databases/$(database)/documents/settings/global).data.activeInstitutionDomain + "$") ||
          studentEmail.matches(".*\\." + get(/databases/$(database)/documents/settings/global).data.activeInstitutionDomain + "$")
        );
        // FERPA Compliance: Only the presentation owner or whitelisted presenter can read the class roster or delete attendance records
        allow read, delete: if isPresenter(presentationId) || isWhitelistedPresenter();
      }
    }

    // ===============================================================
    // Interactive & Chat Collections
    // ===============================================================

    match /messages/{messageId} {
      // Chat messages are viewable and listable by anyone in the session
      allow read: if isAuthenticated();
      // Any authenticated student/presenter can send a message
      allow create: if isAuthenticated();
      // Only the sender, the session presenter, or a whitelisted presenter can edit or delete a message
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        ('presentationId' in resource.data && isPresenter(resource.data.presentationId)) ||
        isWhitelistedPresenter()
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        ('presentationId' in resource.data && isPresenter(resource.data.presentationId)) ||
        isWhitelistedPresenter()
      );
    }

    match /polls/{pollId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        ('presentationId' in request.resource.data && isPresenter(request.resource.data.presentationId)) || 
        isWhitelistedPresenter()
      );
      // Students update the poll doc to register their vote
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (
        ('presentationId' in resource.data && isPresenter(resource.data.presentationId)) || 
        isWhitelistedPresenter()
      );
    }

    match /wordClouds/{cloudId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        ('presentationId' in request.resource.data && isPresenter(request.resource.data.presentationId)) || 
        isWhitelistedPresenter()
      );
      // Students update the wordCloud doc to submit words
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (
        ('presentationId' in resource.data && isPresenter(resource.data.presentationId)) || 
        isWhitelistedPresenter()
      );
    }

    match /openEndedQuestions/{questionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        ('presentationId' in request.resource.data && isPresenter(request.resource.data.presentationId)) || 
        isWhitelistedPresenter()
      );
      // Students update the openEndedQuestion doc to submit responses
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (
        ('presentationId' in resource.data && isPresenter(resource.data.presentationId)) || 
        isWhitelistedPresenter()
      );
    }

    match /questions/{questionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        ('presentationId' in resource.data && isPresenter(resource.data.presentationId)) || 
        isWhitelistedPresenter()
      );
      allow delete: if isAuthenticated() && (
        ('presentationId' in resource.data && isPresenter(resource.data.presentationId)) || 
        isWhitelistedPresenter()
      );
    }

    // ===============================================================
    // Global Settings & Saved Themes
    // ===============================================================

    match /settings/{docId} {
      // Global settings are readable by all clients; writable only by whitelisted presenters / admins
      allow read: if true;
      allow write: if isWhitelistedPresenter();
    }

    match /savedThemes/{docId} {
      // Themes are readable by all clients; writable only by whitelisted presenters / admins
      allow read: if true;
      allow write: if isWhitelistedPresenter();
    }

    // ===============================================================
    // Whitelisted Presenters & Access Control
    // ===============================================================

    match /whitelistedPresenters/{email} {
      // Reading allowed for all authenticated users to check presenter eligibility
      allow read: if isAuthenticated();
      // Only the SuperAdmin can add, modify, or remove whitelisted presenters; SuperAdmin entry cannot be deleted
      allow create, update: if isSuperAdmin();
      allow delete: if isSuperAdmin() && email.lower() != 'justin.zumwalt@okstate.edu';
    }

    // ===============================================================
    // Session Presence, Pins, Previews & Diagnostics
    // ===============================================================

    match /participants/{participantId} {
      // Attendees and presenters sync participant lists and presence counters
      allow read, write: if isAuthenticated();
    }

    match /sessionPins/{pin} {
      // Join screen PIN routing lookup and mapping
      allow read, write: if isAuthenticated();
    }

    match /slidePreviews/{previewId} {
      // Presentation slide previews for live viewing
      allow read, write: if isAuthenticated();
    }

    match /test/{docId} {
      // Connection diagnostics
      allow read, write: if isAuthenticated();
    }
  }
}
